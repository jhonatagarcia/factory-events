{
  "openapi": "3.1.0",
  "info": {
    "title": "Eventos da fábrica",
    "description": "Recebimento de eventos externos e cadastro manual. QUALITY gera auditoria na mesma transação. Reenvios externos retornam 409. Reenvios manuais com o mesmo requestId e conteúdo retornam o evento original. Erros seguem ProblemDetail e incluem code e correlationId. Datas exigem offset.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "tags": [
    {
      "name": "Eventos",
      "description": "Registro e consulta de ocorrências industriais"
    }
  ],
  "paths": {
    "/api/events": {
      "get": {
        "tags": [
          "Eventos"
        ],
        "summary": "Listar eventos paginados",
        "description": "Página inicial 0; size entre 1 e 100. Ordem: recebimento decrescente e ID crescente.",
        "operationId": "findAll",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 0,
              "minimum": 0
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 20,
              "maximum": 100,
              "minimum": 1
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Payload ou parâmetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "ID duplicado ou requestId reutilizado com outros dados",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; consulte os logs pelo correlationId",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Eventos"
        ],
        "summary": "Receber evento de equipamento",
        "description": "O eventId pertence à origem e deve ser preservado em reenvios. IDs existentes retornam 409.",
        "operationId": "create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Payload ou parâmetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "ID duplicado ou requestId reutilizado com outros dados",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; consulte os logs pelo correlationId",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "201": {
            "description": "Evento registrado",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/manual": {
      "post": {
        "tags": [
          "Eventos"
        ],
        "summary": "Cadastrar evento manual",
        "description": "Gera ID no banco. Repetir requestId e conteúdo retorna o evento original, sem novo registro.",
        "operationId": "createManual",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateManualEventRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "400": {
            "description": "Payload ou parâmetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "ID duplicado ou requestId reutilizado com outros dados",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; consulte os logs pelo correlationId",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "201": {
            "description": "Evento criado ou tentativa já confirmada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/EventResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/{eventId}": {
      "get": {
        "tags": [
          "Eventos"
        ],
        "summary": "Consultar evento por identificador",
        "operationId": "findById",
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "Payload ou parâmetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "ID duplicado ou requestId reutilizado com outros dados",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; consulte os logs pelo correlationId",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/events/manual/next-id": {
      "get": {
        "tags": [
          "Eventos"
        ],
        "summary": "Consultar prévia do próximo ID manual",
        "description": "Não reserva o número; ele pode mudar com cadastros concorrentes.",
        "operationId": "nextManualId",
        "responses": {
          "400": {
            "description": "Payload ou parâmetros inválidos",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Evento não encontrado",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "ID duplicado ou requestId reutilizado com outros dados",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Falha interna; consulte os logs pelo correlationId",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateEventRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0,
            "pattern": "[A-Za-z0-9][A-Za-z0-9._-]*"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "PRODUCTION",
              "QUALITY"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "description",
          "eventId",
          "eventType",
          "timestamp"
        ]
      },
      "ProblemDetail": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "format": "uri"
          },
          "properties": {
            "type": "object",
            "additionalProperties": {}
          }
        }
      },
      "EventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "PRODUCTION",
              "QUALITY"
            ]
          },
          "description": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateManualEventRequest": {
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "eventType": {
            "type": "string",
            "enum": [
              "PRODUCTION",
              "QUALITY"
            ]
          },
          "description": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 0
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "description",
          "eventType",
          "requestId",
          "timestamp"
        ]
      }
    }
  }
}
